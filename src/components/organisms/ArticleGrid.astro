---
import ArticleCard from "@/components/molecules/ArticleCard.astro";

interface Item {
	slug: string;
	title: string;
	summary: string;
	category: string;
	status: "draft" | "scheduled" | "published";
}
interface Props {
	items: Item[];
}
const { items } = Astro.props;
---
<section class="grid grid-cols-1 divide-border lg:grid-cols-3 [&>*]:border-border max-lg:divide-y" aria-label="Articles">
  {items.map((a, i) => (
    <div class:list={['relative border-border lg:border-b lg:border-r [&:nth-child(3n)]:border-r-0', i === 0 && 'lg:col-span-2']}>
      <ArticleCard {...a} index={i} featured={i === 0} />
    </div>
  ))}
</section>
